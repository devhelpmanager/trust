		"html": false,
		"anchor": false,
		"align": false,
		"customClassName": false
	},
	"style": "file:./style.css",
	"viewScript": "file:./view.js",
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"blockVersion": 3
	}
